# Local development example. Copy to .env.local and fill in real values.
#
# Note:
# - On Vercel, POSTGRES_* are typically injected by the Neon integration.
# - Do not commit .env.local (it's ignored by .gitignore).

# Neon / Vercel Postgres
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# App auth
TRACKER_PASSWORD=
AUTH_SECRET=

# iOS Shortcuts capture (optional): used by /api/shortcuts/jobs
SHORTCUTS_TOKEN=

